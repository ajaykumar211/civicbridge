# CivicBridge Environment Configuration

# Database: PostgreSQL connection URL (e.g., postgresql://user:pass@localhost:5432/civicbridge)
# If left empty, CivicBridge automatically uses the resilient local database engine preloaded with 40+ seed problems!
DATABASE_URL=""

# Authentication secret for signing JWT tokens
JWT_SECRET="civicbridge_development_super_secret_key_change_in_production"

# Gemini AI API Key (AI Studio automatically injects this at runtime from user secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini AI Models (using latest supported fast models from @google/genai)
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"

# Server & Client configuration
PORT=3000
CLIENT_ORIGIN="http://localhost:3000"
APP_URL="MY_APP_URL"
UPLOAD_DIR="./uploads"
NODE_ENV="development"
